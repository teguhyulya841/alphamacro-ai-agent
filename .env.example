# ==============================================================================
# AlphaMacro-Crypto Environment Configuration
# Copy file ini menjadi .env lalu isi nilai secret sebelum menjalankan aplikasi.
# ==============================================================================

# --- Core LLM & Web Search (Wajib) --------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_search_api_key

# --- Market Data (Opsional: kosongkan untuk CoinGecko public tier) ------------
COINGECKO_API_KEY=

# --- Timeout, Cache & Verification --------------------------------------------
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
HTTP_TIMEOUT=15
CACHE_TTL=60
MAX_QUERY_CHARS=2000
RECURSION_LIMIT=12
GROUNDING_MIN_SCORE=0.80

# --- REST API Security & Rate Limiting ----------------------------------------
# Format: nama_klien:sha256_hex_api_key (pisahkan dengan koma jika lebih dari satu)
# Generate hash: python -c "import hashlib; print(hashlib.sha256(b'rahasia-anda').hexdigest())"
API_KEY_HASHES=admin:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8
API_RATE_LIMIT_PER_MINUTE=30
API_MAX_CONCURRENT_REQUESTS=8

# --- Distributed State Backend (memory | sqlite | redis) ----------------------
# Gunakan 'redis' saat menjalankan multi-worker API + Scheduler via Docker Compose
STATE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SQLITE_PATH=data/alphamacro_state.db

# --- Telegram Delivery & Automated Scheduler (M4) -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SCHEDULER_POLL_INTERVAL_S=60
DIGEST_QUERY=Buat ringkasan kondisi makro global, pergerakan Bitcoin & Ethereum 24 jam terakhir, serta level teknikal utamanya.
DIGEST_INTERVAL_S=86400

# --- Logging & Compliance Audit Trail -----------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_SALT=change-this-random-audit-salt
AUDIT_STORE_QUERY_TEXT=false