# ==============================================================================
# AlphaMacro-Crypto Environment Configuration
# Salin file ini menjadi .env lalu isi nilai secret sebelum menjalankan aplikasi.
# JANGAN commit file .env yang berisi secret asli.
# ==============================================================================

# --- Core LLM & Web Search (Wajib) --------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key
# Nama model dapat berubah/dipensiunkan oleh Google; sesuaikan dengan model yang tersedia.
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_search_api_key

# --- Market Data (Opsional: kosongkan untuk CoinGecko public tier) ------------
COINGECKO_API_KEY=

# --- Timeout, Cache & Verification --------------------------------------------
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
HTTP_TIMEOUT=15
CACHE_TTL=60
MAX_QUERY_CHARS=2000
RECURSION_LIMIT=12
GROUNDING_MIN_SCORE=0.80

# --- REST API Security & Rate Limiting ----------------------------------------
# Format: nama_klien:sha256_hex_api_key (pisahkan dengan koma jika lebih dari satu)
# Generate hash dari API key pilihan Anda:
#   python -c "import hashlib; print(hashlib.sha256(b'API-KEY-ANDA').hexdigest())"
# WAJIB diganti. Gunakan API key panjang dan acak, jangan kata umum.
API_KEY_HASHES=admin:REPLACE_WITH_SHA256_HEX
API_RATE_LIMIT_PER_MINUTE=30
API_MAX_CONCURRENT_REQUESTS=8

# --- State Backend (memory | sqlite | redis) ----------------------------------
# Default untuk pemakaian lokal (CLI / uvicorn tanpa Docker): sqlite.
# Saat memakai Docker Compose, service api & scheduler otomatis memakai
# redis://redis:6379/0 (di-override di docker-compose.yml).
# Bila ingin memakai Redis lokal, ubah STATE_BACKEND=redis dan sesuaikan REDIS_URL.
STATE_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=data/alphamacro_state.db

# --- Telegram Delivery & Automated Scheduler (M4) -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SCHEDULER_POLL_INTERVAL_S=60
DIGEST_QUERY="Buat ringkasan kondisi makro global, pergerakan Bitcoin & Ethereum 24 jam terakhir, serta level teknikal utamanya."
DIGEST_INTERVAL_S=86400

# --- Logging & Compliance Audit Trail -----------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl
# WAJIB diganti dengan string acak panjang (mis. hasil: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SALT=REPLACE_WITH_RANDOM_SALT
AUDIT_STORE_QUERY_TEXT=false