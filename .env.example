# ==============================================================================
# AlphaMacro-Crypto - Environment Configuration
# Copy this file to .env and fill in the secret values before running the app.
# NEVER commit a .env file that contains real secrets.
# ==============================================================================

# --- Core LLM & Web Search (required) -----------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key
# Model names may be renamed or retired by Google; use a model available to you.
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_search_api_key

# --- Market Data (optional: leave empty to use the CoinGecko public tier) -----
COINGECKO_API_KEY=

# --- Timeouts, Retries, Cache & Verification ----------------------------------
# Per-call model timeouts, in seconds.
AGENT_LLM_TIMEOUT=120
ROUTER_LLM_TIMEOUT=20
# Retries performed inside the Google client for a single model call.
LLM_MAX_RETRIES=2
# Agent-level retries (the last attempt may use the fallback model) and the
# total time budget across all attempts for one request, in seconds.
AGENT_MAX_ATTEMPTS=3
AGENT_OVERALL_TIMEOUT=240
# Optional: model used for the last attempt when the primary model keeps
# failing (503/504/429). Leave empty to disable the fallback.
GEMINI_FALLBACK_MODEL=
# Tavily search tuning: "basic" returns less context and is faster.
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced
HTTP_TIMEOUT=15
CACHE_TTL=60
MAX_QUERY_CHARS=2000
RECURSION_LIMIT=12
GROUNDING_MIN_SCORE=0.80

# --- REST API Security & Rate Limiting ----------------------------------------
# Format: client_name:sha256_hex_of_api_key (comma-separated for multiple keys).
# Generate the hash from an API key of your choice:
#   python -c "import hashlib; print(hashlib.sha256(b'YOUR-API-KEY').hexdigest())"
# MUST be replaced. Use a long, random API key; never a common word.
API_KEY_HASHES=admin:REPLACE_WITH_SHA256_HEX
API_RATE_LIMIT_PER_MINUTE=30
API_MAX_CONCURRENT=8

# --- State Backend (memory | sqlite | redis) ----------------------------------
# Default for local use (CLI / uvicorn without Docker): sqlite.
# With Docker Compose, the api and scheduler services use
# redis://redis:6379/0 automatically (overridden in docker-compose.yml).
# To use a local Redis instead, set STATE_BACKEND=redis and adjust the URL below.
STATE_BACKEND=sqlite
STATE_REDIS_URL=redis://localhost:6379/0
STATE_SQLITE_PATH=data/alphamacro_state.db

# --- Telegram Delivery & Automated Scheduler ----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SCHEDULER_POLL_INTERVAL_S=60
DIGEST_QUERY="Summarize the global macro backdrop, Bitcoin and Ethereum price action over the last 24 hours, and the key technical levels."
DIGEST_INTERVAL_S=86400

# --- Logging & Compliance Audit Trail -----------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=logs/audit.jsonl
# MUST be replaced with a long random string, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SALT=REPLACE_WITH_RANDOM_SALT
AUDIT_STORE_QUERY_TEXT=false
