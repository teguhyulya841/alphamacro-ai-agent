# ============================================================
# AlphaMacro-Crypto configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# --- Required ---------------------------------------------------
GOOGLE_API_KEY=
TAVILY_API_KEY=

# --- Required only for the Telegram bot -------------------------
TELEGRAM_TOKEN=

# --- Optional: model & data providers ---------------------------
# Verify the model name is available to your key in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# CoinGecko demo key (optional; raises rate limits)
COINGECKO_API_KEY=

# --- Optional: bot access control & limits ----------------------
# Comma-separated Telegram user IDs. Empty = public bot.
TELEGRAM_ALLOWED_USER_IDS=
BOT_RATE_LIMIT_PER_MINUTE=5
BOT_MAX_CONCURRENT_JOBS=4

# --- Optional: tuning -------------------------------------------
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
HTTP_TIMEOUT=15
CACHE_TTL_SECONDS=60
MAX_QUERY_CHARS=1500
AGENT_RECURSION_LIMIT=25

# --- Optional: verification & audit trail ----------------------
# Reports with a numeric-grounding score below this get a data-quality warning.
GROUNDING_MIN_SCORE=0.8
# Set a path to enable the tamper-evident audit log (then AUDIT_SALT is required).
AUDIT_LOG_PATH=
# Random secret used to pseudonymise user IDs, e.g.: python -c "import secrets;print(secrets.token_hex(32))"
AUDIT_SALT=
# Default false: only a hash of each query is stored, never its text.
AUDIT_STORE_QUERY_TEXT=false

# --- Optional: REST API (alphamacro-api) ------------------------
# Create keys with:  alphamacro-keygen <name>   and paste the printed value here.
API_KEY_HASHES=
API_RATE_LIMIT_PER_MINUTE=30
API_MAX_CONCURRENT=4
API_HOST=127.0.0.1
API_PORT=8000

# --- Optional: logging ------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: text | json (json recommended in containers)
LOG_FORMAT=text

# --- Optional: Scheduled Morning Briefing -----------------------
# Raw API key (not a hash) generated by: alphamacro-keygen scheduler
SCHEDULER_RAW_API_KEY=
# Target Telegram Chat ID for receiving the briefing (can be obtained from TELEGRAM_ALLOWED_USER_IDS)
BRIEFING_CHAT_ID=
# Automated execution schedule in the WIB (Asia/Jakarta) time zone
BRIEFING_HOUR=7
BRIEFING_MINUTE=0